{
  "stryker-config": {
    "project": "Emby.Xtream.Plugin.csproj",
    "mutate": [
      "**/Service/StrmOwnership.cs",
      "**/Service/StrmSyncService.Cleanup.cs"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 75
    },
    "concurrency": 4,
    "ignore-methods": [
      "*.Debug",
      "*.Info",
      "*.Warn",
      "*.Error"
    ]
  }
}
